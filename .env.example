# ===== AfriHost AI — variables d'environnement (jamais committer le .env réel) =====

# Base de données (local dev via docker-compose, prod via Supabase)
DATABASE_URL="postgresql://afrihost:afrihost@localhost:5432/afrihost"

# Supabase (Auth / Storage / Realtime) — prod
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase Auth JWT secret (pour vérifier les tokens côté serveur)
SUPABASE_JWT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# Notifications (rempli au module 30)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
SENDGRID_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Paiements (rempli plus tard)
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# IA (rempli au module 31)
OPENAI_API_KEY=""
